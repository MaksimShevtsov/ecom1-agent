# Copy to .env and fill in. Never commit .env.

# z.ai (GLM Coding Plan)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
MODEL_ID=glm-5.3
FALLBACK_MODEL_ID=glm-5.2
# low | high | max (GLM-5.3 always reasons; this sets reasoning_effort)
THINKING_EFFORT=high
# Judge model for A/B capabilities (tool_judge, trajectory)
JUDGE_MODEL_ID=glm-5.3-flash

# BitGN
BITGN_API_KEY=
BITGN_HOST=https://api.bitgn.com
BENCHMARK_ID=bitgn/ecom1-dev

# Agent loop
MAX_STEPS=40
CONCURRENCY=1
# Comma-separated A/B capabilities: reminders,planning,tool_judge,defender,defender_ml,trajectory
# (prompt-injection audit is always on; `defender` blocks, `defender_ml` needs `uv sync --extra defender-ml`)
AGENT_FLAGS=

# Logfire (optional; traces are only sent when a token is present)
LOGFIRE_TOKEN=
